# Pokerpot at litescript.net/poker — no new DNS record needed.
#
# A snippet for an existing Caddyfile, not a standalone config.
#
# Two traps, both hit in the wild:
#
# 1. Caddy runs `redir` BEFORE `handle`, whatever order they appear in, so an
#    unconditional apex -> www redirect swallows /poker before handle_path
#    sees it. Put the redirect in a catch-all `handle` block instead: handle
#    blocks are mutually exclusive and evaluated in written order, so the
#    first match wins and no negated matcher is needed.
#
# 2. Serve it from a block with no restrictive Content-Security-Policy. The
#    app is a single inline <script> and pulls fonts from Google, so a
#    `script-src 'self'` policy renders it a blank page.

litescript.net {
	# ... your existing HSTS / imports ...

	handle_path /poker* {
		reverse_proxy 127.0.0.1:8082
	}

	# Everything else goes to the canonical host.
	handle {
		redir https://www.litescript.net{uri} 308
	}
}

# Optional: so www.litescript.net/poker works too, rather than 404ing.
www.litescript.net {
	@poker path /poker /poker/*
	redir @poker https://litescript.net{uri} 308

	# ... the rest of your site ...
}
