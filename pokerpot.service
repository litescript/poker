# Install:
#   cp pokerpot.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pokerpot
#   systemctl status pokerpot
[Unit]
Description=Pokerpot
After=network.target

[Service]
Type=simple
# No User= — systemd runs units as root by default. Setting it explicitly is
# redundant, and on some systems resolving it fails the unit with 217/USER.
WorkingDirectory=/srv/poker
Environment=PORT=8082
Environment=HOST=127.0.0.1
Environment=POKERPOT_BASE=/poker
Environment=POKERPOT_PIN=changeme
ExecStart=/usr/bin/env node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
